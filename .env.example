# ---------------------------------------------------------------------------
# Exemple de configuration par variables d'environnement.
#
# Copiez ce fichier en `.env` et adaptez les valeurs. `.env` est ignore par Git
# et ne doit JAMAIS contenir de secret reel dans le depot.
#
#   Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# --- Projet ----------------------------------------------------------------
# Racine du projet. Normalement deduite automatiquement de l'emplacement du
# paquet ; a definir uniquement si le paquet est installe ailleurs.
# PPE_PROJECT_ROOT=C:\chemin\vers\le\projet

# --- API REST --------------------------------------------------------------
# Poids charges au demarrage du service.
PPE_API_WEIGHTS=artifacts/models/best.pt

# Device d'inference : auto | cpu | cuda | 0
PPE_API_DEVICE=auto

# Seuils de detection.
PPE_API_CONF=0.25
PPE_API_IOU=0.45

# Active la couche de conformite EPI dans les reponses (heuristique).
PPE_API_COMPLIANCE=false

# Limites de securite des entrees.
PPE_API_MAX_FILE_MB=10
PPE_API_MAX_BATCH=16

# Serveur.
PPE_API_HOST=127.0.0.1
PPE_API_PORT=8000
PPE_API_RELOAD=false
PPE_API_LOG_LEVEL=INFO
PPE_API_TITLE=PPE Detection API

# --- Ultralytics -----------------------------------------------------------
# Reduit la verbosite de la bibliotheque.
# YOLO_VERBOSE=False

# Desactive la telemetrie anonyme d'Ultralytics.
# YOLO_OFFLINE=True
